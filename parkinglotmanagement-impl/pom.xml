<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.netcracker</groupId>
        <artifactId>parkinglotmanagement</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>parkinglotmanagement-impl</artifactId>
    <name>parkinglotmanagement-impl</name>
    <description>jOOQ repositories, service implementations and the generated jOOQ schema classes</description>

    <dependencies>
        <dependency>
            <groupId>com.netcracker</groupId>
            <artifactId>parkinglotmanagement-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.netcracker</groupId>
            <artifactId>parkinglotmanagement-database</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jooq</artifactId>
        </dependency>

        <dependency>
            <groupId>cz.jirutka.rsql</groupId>
            <artifactId>rsql-parser</artifactId>
        </dependency>

        <!-- Tests run the real Flyway migrations against an in-memory H2 database. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jooq</groupId>
                <artifactId>jooq-codegen-maven</artifactId>
                <!--
                  Code generation runs entirely offline. jooq-meta-extensions-hibernate lets
                  jOOQ derive the schema from the JPA entity model in parkinglotmanagement-api
                  (Hibernate exports the DDL into a throwaway in-memory H2), so `mvn install`
                  never needs a live PostgreSQL. These stay plugin-scoped so Hibernate's own
                  version does not leak into the module's runtime classpath.
                -->
                <dependencies>
                    <dependency>
                        <groupId>org.jooq</groupId>
                        <artifactId>jooq-meta-extensions-hibernate</artifactId>
                        <version>${jooq.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>com.h2database</groupId>
                        <artifactId>h2</artifactId>
                        <version>${h2.version}</version>
                    </dependency>
                    <!-- hibernate-core does not pull the JPA API itself; JPADatabase needs it. -->
                    <dependency>
                        <groupId>javax.persistence</groupId>
                        <artifactId>javax.persistence-api</artifactId>
                        <version>2.2</version>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <id>generate-jooq-sources</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <configurationFile>src/main/resources/jooqGeneratorConfig.xml</configurationFile>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
