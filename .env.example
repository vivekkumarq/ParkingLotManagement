# Copy to .env and adjust. Every value here has a working default in
# application.properties, so the file is only needed to override them.
#
#   cp .env.example .env
#
# .env is gitignored - never commit real credentials.

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------
# Port the application listens on.
SERVER_PORT=8083
# Host port docker compose publishes the app on.
APP_PORT=8083

# ---------------------------------------------------------------------------
# Database (application)
# ---------------------------------------------------------------------------
# JDBC URL. Use jdbc:h2:mem:... with DB_DRIVER=org.h2.Driver for a throwaway
# database, or activate the `dev` profile which sets that up for you.
DB_URL=jdbc:postgresql://localhost:5432/parkinglotmanagement
DB_USERNAME=parking
DB_PASSWORD=parking
DB_DRIVER=org.postgresql.Driver

# HikariCP pool.
DB_POOL_MAX=10
DB_POOL_MIN=2
DB_CONNECTION_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# Database (the postgres container in docker-compose.yml)
# ---------------------------------------------------------------------------
POSTGRES_DB=parkinglotmanagement
POSTGRES_USER=parking
POSTGRES_PASSWORD=parking
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Schema and SQL generation
# ---------------------------------------------------------------------------
# Set false only if migrations are applied out of band.
FLYWAY_ENABLED=true
# Lets Flyway adopt a database that already has the V1 tables.
FLYWAY_BASELINE_ON_MIGRATE=true
# Must match the database: Postgres or H2.
JOOQ_DIALECT=Postgres

# ---------------------------------------------------------------------------
# Rate card
# ---------------------------------------------------------------------------
# ISO currency code, echoed in fee breakdowns and revenue reports.
RATE_CURRENCY=INR
# A stay no longer than this is free.
RATE_GRACE_MINUTES=15
# Charged per started hour a reserved stay runs past its window.
RATE_OVERSTAY_PER_HOUR=50.00

# Per vehicle type: the first chargeable hour, each hour after it, and the
# ceiling for any 24-hour period.
RATE_MOTORCYCLE_FIRST_HOUR=20.00
RATE_MOTORCYCLE_ADDITIONAL_HOUR=10.00
RATE_MOTORCYCLE_DAILY_CAP=100.00

RATE_CAR_FIRST_HOUR=50.00
RATE_CAR_ADDITIONAL_HOUR=30.00
RATE_CAR_DAILY_CAP=400.00

RATE_TRUCK_FIRST_HOUR=100.00
RATE_TRUCK_ADDITIONAL_HOUR=60.00
RATE_TRUCK_DAILY_CAP=800.00

# ---------------------------------------------------------------------------
# Background reservation-expiry sweep
# ---------------------------------------------------------------------------
RESERVATION_EXPIRY_ENABLED=true
RESERVATION_EXPIRY_INTERVAL_MS=300000
RESERVATION_EXPIRY_INITIAL_DELAY_MS=60000

# ---------------------------------------------------------------------------
# Documentation and operations
# ---------------------------------------------------------------------------
# Set false to hide Swagger UI and /v3/api-docs in production.
SPRINGDOC_ENABLED=true
ACTUATOR_ENDPOINTS=health,info
# never | when-authorized | always
ACTUATOR_HEALTH_DETAILS=never
# Cap for the .xlsx bulk upload.
MAX_UPLOAD_SIZE=5MB
